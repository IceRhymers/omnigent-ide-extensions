# Controls what goes INTO the .vsix. The runtime is the esbuild bundle
# (dist/extension.js) + the icons under media/. Everything else is dev-only.

# TypeScript sources (only the built .js is needed at runtime)
src/**
**/*.ts

# Dev tooling / config
esbuild.js
scripts/**
tsconfig.json
vitest.config.ts
**/*.test.*
**/__mocks__/**
.gitignore
.vscodeignore
.prettierrc.json
.prettierignore
pnpm-lock.yaml
pnpm-workspace.yaml

# Repository docs that aren't part of the listing
PUBLISHING.md
PROVENANCE.md

# Source maps (drop to keep the package smaller)
**/*.map

# Dependencies are bundled into dist/ by esbuild — not needed in the package
node_modules/**

# Keep (NOT ignored): dist/** (the bundled extension; dist/web-ui, the app
# served for Databricks workspaces; dist/web-ui-licenses.md, its third-party
# licenses), media/** (icons), package.json, README.md, CHANGELOG.md, LICENSE, NOTICE
